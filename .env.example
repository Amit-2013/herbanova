# HERBANOVA Business Control System - PRODUCTION environment settings
# Copy this file to `.env` on the server and fill in real values.
# NEVER commit or e-mail the real .env file.

# Anything other than "local" makes the session cookie Secure -> HTTPS is required.
APP_ENV=production

# PostgreSQL connection URL. Use a strong password and a dedicated database user.
DATABASE_URL=postgresql+psycopg://herbanova_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/herbanova_bcs

# Long random string that signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# The exact address users type in the browser, e.g. https://bcs.yourcompany.com
CORS_ORIGINS=https://bcs.yourcompany.com

# Kept for the demo seeder only. The old single-step database wipe endpoint is
# retired and now answers 410; guarded reset lives under DB_RESET_* below.
DEMO_MODE=false

LOG_LEVEL=INFO

# Optional Telegram alerts. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_LOGIN=false

# ---------------------------------------------------------------- DB reset
# Guarded "Reset Database" screen. OFF unless explicitly enabled here. When
# DB_RESET_ENABLED is false the screen shows as disabled and every reset
# endpoint refuses. Requires PostgreSQL client tools (pg_dump, pg_restore)
# on PATH or DB_RESET_PG_BIN.
DB_RESET_ENABLED=false

# Two backup locations on DIFFERENT disks (or a mounted network share). The
# service refuses to start a reset when both resolve to the same device.
DB_RESET_BACKUP_DIR=
DB_RESET_BACKUP_MIRROR_DIR=

# Fernet key used to encrypt both backup copies. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUT of the database host's backup target, or a stolen dump is useless
# but a lost key makes every dump unrecoverable. Never commit this value.
DB_RESET_ENCRYPTION_KEY=

# Run journal, lockout counters and the append-only audit file live here, so
# they survive a full reset that drops the database. Default: var/db-reset
DB_RESET_STATE_DIR=var/db-reset

# Final confirmation token lifetime (minutes) and the earlier step tokens.
DB_RESET_CONFIRM_MINUTES=10
DB_RESET_TOKEN_MINUTES=30

# Wrong-attempt lockout for the whole feature, per administrator. The same
# value also bounds how long an abandoned maintenance pause can last.
DB_RESET_MAX_ATTEMPTS=3
DB_RESET_LOCKOUT_MINUTES=60

# Optional directory holding pg_dump/pg_restore when they are not on PATH,
# e.g. C:\Program Files\PostgreSQL\17\bin
DB_RESET_PG_BIN=

